{
  "name": "@vipintom/vstack",
  "version": "0.2.0",
  "description": "vstack 0.2.0 — a 54-skill agentic development playbook with playbooks, principles, roles, rubrics and executable evaluations",
  "type": "module",
  "files": [
    "skills",
    "playbooks",
    "principles",
    "roles",
    "rubrics",
    "templates",
    "evaluations",
    "harnesses",
    "schema",
    "tools",
    "manifest.json",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "validate": "node tools/validate.js",
    "gen": "node tools/gen-docs.js",
    "test": "node --test",
    "verify": "node tools/validate.js && node --test",
    "install:opencode": "node tools/install.js opencode"
  },
  "keywords": [
    "vstack",
    "playbook",
    "engineering",
    "ai-agents",
    "skills",
    "playbooks",
    "opencode"
  ],
  "author": "Vipin Tom",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vipintom/vstack-playbook.git"
  },
  "homepage": "https://github.com/vipintom/vstack-playbook#readme",
  "bugs": {
    "url": "https://github.com/vipintom/vstack-playbook/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
